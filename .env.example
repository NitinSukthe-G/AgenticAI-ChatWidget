# Copy this file to .env and fill in your real values. Never share .env with anyone.

# Your MongoDB connection URL (e.g. from MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name that will be created inside your MongoDB
DB_NAME=paddus_sweets

# Password for the admin panel at http://localhost:8000/#/admin
ADMIN_PASSWORD=admin123

# Sarvam AI key for Laddu the chatbot (from https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Only for running Laddu on its own (python app.py): its port, and which websites may embed it
# (comma-separated list of website addresses, or * for any)
LADDU_PORT=8001
LADDU_ALLOWED_ORIGINS=*
